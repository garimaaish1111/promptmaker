# Copy to .env.local and fill in.
#
# The Anthropic SDK resolves credentials in this order:
#   1. ANTHROPIC_API_KEY
#   2. ANTHROPIC_AUTH_TOKEN
#   3. an `ant auth login` profile stored on disk
#
# Set the first one and you are done. Get a key from console.anthropic.com.
# .env.local is gitignored — never commit a real key.

ANTHROPIC_API_KEY=sk-ant-...
